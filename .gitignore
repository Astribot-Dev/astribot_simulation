# 本地配置文件
.config
.settings
.vscode/
.tmp/

# ---------------------------------------------------------------------------
# 发布版收敛：scripts/ 表层只留环境安装脚本（install.sh / build.sh / lite_install/），
# 环境测试在 scripts/verify/。以下开发期调试/实验/SLAM 脚本本地保留（文件仍在工作区），
# 但不入仓。
# ---------------------------------------------------------------------------
scripts/debug/
scripts/pipeline/
scripts/slam/
scripts/setup/
scripts/depends/
scripts/lite_install/
scripts/verify/
scripts/sensors/

# Sensor calibration is not consumed by any code path (sensors are unsupported
# in this release); keep it locally but out of the release tree.
config/astribot_s1/sensor_calib.json

# rosbag QoS override files: only used by the SLAM/debug scripts, which are not
# part of the release. No code path loads them.
config/bag_qos_override.yaml
config/qos/

# Internal development guide for AI assistants; not a release artifact.
CLAUDE.md

# Stray empty root __init__.py: packaging only looks under src/ (see
# pyproject [tool.setuptools.packages.find]), and this makes the repo root
# look importable as a package.
/__init__.py

# Immature backends: ManiSkill and Isaac Lab are not part of this release.
# The factory resolves backends by module name, so dropping these files from
# the tree is enough -- nothing imports them.
src/astribot_envs/astribot_isaaclab_env.py
src/astribot_envs/astribot_maniskill_env.py

# IDE / AI-assistant working notes: internal, not release artifacts.
.claude/
.marscode/

# CI and lint tooling: not mature enough to ship with the release build.
# Files stay locally so development tooling keeps working.
.gitlab-ci.yml
.pre-commit-config.yaml
.flake8

